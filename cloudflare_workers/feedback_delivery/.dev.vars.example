# Example environment variables for local testing with `wrangler dev`
# Copy this file to `.dev.vars` (which is in .gitignore) and fill in your values.
# DO NOT COMMIT `.dev.vars` TO VERSION CONTROL.

# Brevo (Sendinblue) Transactional Email Configuration
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxx"
SENDER_EMAIL="feedback@yourverifieddomain.com"
SENDER_NAME="Project Arc Feedback"
RECIPIENT_EMAIL="your_email@example.com"

# Firebase Service Account Credentials (from Firebase Console -> Project Settings -> Service accounts)
FIREBASE_PROJECT_ID="arc-productivity-shreyas"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@arc-productivity-shreyas.iam.gserviceaccount.com"
# Note: In .dev.vars, include the full multi-line private key or replace newlines with \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Optional secret for triggering manual POST /dispatch requests
CRON_SECRET="optional_random_long_token_here"
